# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/startuppreflight

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better-Auth Session Encryption Secret (32+ character random string)
BETTER_AUTH_SECRET=your-32-character-random-secret-key-here

# Google OAuth 2.0 Credentials (for Google Sign-In & Sign-Up)
# Obtain from https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Gemini AI API Configuration
# Option 1: Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Option 2: Direct Gemini API key (Server-side only)
# GEMINI_API_KEY=your-gemini-api-key

# Stripe Payments & Billing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend Transactional Email
RESEND_API_KEY=re_...
EMAIL_FROM_SYSTEM=Startup Preflight <system@startuppreflight.com>
EMAIL_FROM_NOTIFICATIONS=Startup Preflight <team@startuppreflight.com>
EMAIL_REPLY_TO=tom@startuppreflight.com
ADMIN_NOTIFICATION_EMAIL=tom@startuppreflight.com
